# Copy to .env.deploy on the server. Replace every CHANGE_ME value.
# Both origins must resolve from the browser and the server containers.
APP_ENV=production
APP_PORT=3000
S3_PORT=9000
BETTER_AUTH_URL=https://app.example.com
S3_ENDPOINT=https://files.example.com
BETTER_AUTH_SECRET=CHANGE_ME_RANDOM_64_HEX_CHARACTERS

POSTGRES_USER=weekly
POSTGRES_PASSWORD=CHANGE_ME_HEX_DATABASE_PASSWORD
POSTGRES_DB=weekly

S3_REGION=us-east-1
S3_BUCKET=weekly-attachments
S3_ACCESS_KEY_ID=weekly-storage
S3_SECRET_ACCESS_KEY=CHANGE_ME_OBJECT_STORAGE_PASSWORD
ATTACHMENT_SCANNER_TOKEN=CHANGE_ME_RANDOM_64_HEX_CHARACTERS

NODE_IMAGE=node:22-alpine
REMINDER_ORGANIZATION_ID=
CALENDAR_YEAR=2026
