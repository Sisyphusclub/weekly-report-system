{
  "name": "weekly-report-system",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format:check": "prettier --check src/app src/lib src/components/workspace tests scripts *.ts *.mjs package.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "node scripts/verify.mjs",
    "verify:e2e": "npm run verify && npm run test:e2e",
    "config:check": "tsx --env-file-if-exists=.env.local scripts/check-config.ts",
    "dev:env": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-dev-env.ps1",
    "dev:infra:up": "docker compose --env-file .env.local -f docker-compose.dev.yml up -d",
    "dev:infra:down": "docker compose --env-file .env.local -f docker-compose.dev.yml down",
    "dev:infra:logs": "docker compose --env-file .env.local -f docker-compose.dev.yml logs -f",
    "test:database": "tsx scripts/test-database.ts",
    "test:storage": "tsx --env-file-if-exists=.env.local scripts/test-storage-scan.ts",
    "test:browser": "tsx --env-file-if-exists=.env.local scripts/test-browser-isolated.ts",
    "test:auth": "tsx --env-file-if-exists=.env.local scripts/test-auth-isolated.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "admin:bootstrap": "tsx --env-file-if-exists=.env.local scripts/bootstrap-admin.ts",
    "security:reset-totp": "tsx --env-file-if-exists=.env.local scripts/reset-totp.ts",
    "reminders:run": "tsx --env-file-if-exists=.env.local scripts/run-reminders.ts",
    "attachments:cleanup": "tsx --env-file-if-exists=.env.local scripts/cleanup-attachments.ts",
    "login-audit:cleanup": "tsx --env-file-if-exists=.env.local scripts/cleanup-login-audit.ts",
    "backup:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-backup.ps1",
    "weekly:drafts": "tsx --env-file-if-exists=.env.local scripts/generate-weekly-drafts.ts",
    "calendar:seed": "tsx --env-file-if-exists=.env.local scripts/seed-china-calendar.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1135.0",
    "@aws-sdk/s3-request-presigner": "^3.1135.0",
    "@internationalized/date": "^3.12.1",
    "@remixicon/react": "^4.9.0",
    "@tailwindcss/postcss": "^4.3.3",
    "better-auth": "1.7.5",
    "drizzle-orm": "0.45.2",
    "exceljs": "^4.4.0",
    "motion": "^12.42.2",
    "next": "16.3.5",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-aria-components": "^1.21.1",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "prettier": "3.9.7",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
